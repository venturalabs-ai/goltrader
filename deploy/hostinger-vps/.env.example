# Goltrader na VPS — MODELO. Copie para ".env" (ao lado do docker-compose.yml, permissão 600) e preencha lá.
# NUNCA coloque valores reais neste arquivo nem no Git.

# ---- Rede / domínio ----
# Hostname que o Traefik atende. Antes de o domínio próprio apontar para 187.127.13.69 use o host de preview da VPS.
GOLTRADER_DOMAIN=goltrader.srv1925412.hstgr.cloud
GOLTRADER_CERTRESOLVER=letsencrypt
GOLTRADER_TRAEFIK_NETWORK=goltrader_default
GOLTRADER_API_LOCAL_PORT=18000
TZ=America/Sao_Paulo

# ---- Segurança da API (OBRIGATÓRIO) ----
# Token Bearer das rotas POST /api/v1/* e do WebSocket. Gere:  openssl rand -base64 32
GOLTRADER_API_TOKEN=

# ---- Travas de modo (padrão: TESTNET) ----
BYBIT_TESTNET=true
ANALYZER_MODE=true
GOLTRADER_ALLOW_LIVE=false
# Só preencha com CONFIRMAR depois que o dono mandar operar em conta real (veja docs/DEPLOY-VPS.md, seção "Conta real").
GOLTRADER_LIVE_CONFIRMATION=
# Hostname da VPS que PODE operar real (atualizar.sh recusa LIVE em outra máquina). Ex.: srv1925412
GOLTRADER_LIVE_HOST=

# ---- Dados do Pulse ----
GOLTRADER_DATA_SOURCE=bybit

# ---- Bybit (Testnet: https://testnet.bybit.com — chave SEM permissão de saque) ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Chaves reais: só para LIVE, depois do "CONFIRMAR". Restrinja a chave real ao IP da VPS (187.127.13.69) na Bybit.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=

# ---- Limites de risco do worker ----
GOLTRADER_MAX_POSITION_USD=1000
GOLTRADER_MAX_ORDER_USD=500
GOLTRADER_MAX_DAILY_LOSS_USD=100
GOLTRADER_MAX_ORDERS_PER_MIN=20
GOLTRADER_LEASE_TTL=30

# ---- Alertas Telegram do watchdog (opcional; vazio = sem alerta) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Extras opcionais de adapters desligados (build): ex. "ccxt" ----
GOLTRADER_EXTRA_PIP=
