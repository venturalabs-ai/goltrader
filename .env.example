# Goltrader — modelo de variaveis. Copie os NOMES para o .env e preencha la (nunca aqui).
# Chaves separadas por conta (preferido pelo painel):
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=
# Legado (motor antigo): BYBIT_API_KEY/SECRET valem para a conta indicada por BYBIT_TESTNET (true=testnet, false=real)
BYBIT_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1
DEFAULT_PAYOUT=0.85
EXPIRY_CANDLES=1
# --- Camada multi-corretora (adapters desligados por padrão; só bybit habilitado) ---
GT_BROKERS_ENABLED=bybit
# Nomes de variáveis dos demais adapters (preencher só no .env, nunca aqui):
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
PEPPERSTONE_CTRADER_CLIENT_ID=
PEPPERSTONE_CTRADER_CLIENT_SECRET=
IQOPTION_EMAIL=
IQOPTION_PASSWORD=
