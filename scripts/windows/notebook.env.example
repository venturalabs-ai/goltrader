# Goltrader no NOTEBOOK — modelo de .env (somente TESTNET). Copiado para <raiz>\.env pelo instalar-atualizar.ps1.
# Nunca coloque valores reais aqui no repositório; preencha só no .env local (ignorado pelo Git).
# O rodar-testnet.ps1 FORÇA Testnet/ANALYZER mesmo que este arquivo diga outra coisa: o notebook não opera conta real.
BYBIT_TESTNET=true
ANALYZER_MODE=true
GOLTRADER_ALLOW_LIVE=false
GOLTRADER_DATA_SOURCE=bybit
# Gerado automaticamente pelo rodar-testnet.ps1 se ficar vazio:
GOLTRADER_API_TOKEN=
GOLTRADER_CORS_ORIGINS=http://localhost:5173
# Chaves da Testnet Bybit (https://testnet.bybit.com), SEM permissão de saque:
BYBIT_API_KEY=
BYBIT_API_SECRET=
GOLTRADER_MAX_POSITION_USD=1000
GOLTRADER_MAX_ORDER_USD=500
GOLTRADER_MAX_DAILY_LOSS_USD=100
GOLTRADER_MAX_ORDERS_PER_MIN=20
