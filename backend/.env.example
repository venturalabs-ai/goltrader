# ===== Goltrader backend — EXEMPLO (somente placeholders; copie para .env LOCAL, que é ignorado pelo Git) =====

# --- Segurança da API ---
# Token Bearer exigido nas rotas POST /api/v1/* e no WebSocket (?token=). Gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se ficar vazio, o servidor recusa chamadas que alteram estado (503) e só serve o WebSocket para loopback.
GOLTRADER_API_TOKEN=
# Origens permitidas no CORS (separadas por vírgula). Nunca use "*".
GOLTRADER_CORS_ORIGINS=http://localhost:5173

# --- Modo de operação ---
# true = ANALYZER (paper, nenhuma ordem sai). false = ordens vão às corretoras (ainda exige toggle_mode + "CONFIRMAR").
ANALYZER_MODE=true
# Trava extra: só com true o servidor aceita ir para LIVE. Mantenha false até testar tudo na Testnet.
GOLTRADER_ALLOW_LIVE=false

# --- Fonte de dados do Pulse ---
# simulado = dados SINTÉTICOS (ordens do funil são sempre paper) | bybit = feed público Bybit (sem chaves)
GOLTRADER_DATA_SOURCE=simulado

# --- Limites de risco ---
GOLTRADER_MAX_ORDERS_PER_MIN=30
GOLTRADER_MAX_DAILY_LOSS_USD=200
GOLTRADER_MAX_LEVERAGE=10
GOLTRADER_FUNNEL_QTY=0.001
GOLTRADER_FUNNEL_COOLDOWN_S=60
GOLTRADER_FUNNEL_IQ=false

# --- Bybit V5 (use chaves da TESTNET: https://testnet.bybit.com — sem permissão de saque) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- IQ Option (NÃO há API oficial; usa websocket não oficial; risco de bloqueio de conta/ToS) ---
IQ_EMAIL=
IQ_PASSWORD=
IQ_BALANCE_MODE=PRACTICE
